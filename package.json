{
  "name": "dsh-fish-dream",
  "version": "0.1.0",
  "description": "给 dsh-fish 里的她做梦：安静够久之后，从她真实的事件流里挑碎片，按六种梦理论之一拼成「梦的种子」，她自己把梦写完。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:sandbox": "node --test --experimental-test-isolation=none"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-fish",
    "dream"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxxiii/dsh-fish-dream.git"
  },
  "homepage": "https://github.com/xxxiii/dsh-fish-dream#readme",
  "bugs": {
    "url": "https://github.com/xxxiii/dsh-fish-dream/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
